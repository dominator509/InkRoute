{
  "phase": "15",
  "status": "audit_contract_not_configured",
  "command": "pnpm deploy:verify-secrets",
  "redactionPolicy": {
    "secretValuesAllowedInGit": false,
    "evidenceMustBeRedacted": true,
    "allowedEvidenceExamples": [
      "GitHub Actions environment secret name",
      "Vercel secret reference label",
      "EAS secret reference label",
      "Sentry project setting label",
      "rotation ticket id",
      "masked CI log artifact id"
    ],
    "forbiddenEvidenceExamples": [
      "plaintext secret",
      "database URL",
      "provider token",
      "webhook signing secret",
      "private key material"
    ]
  },
  "rotationPolicy": {
    "defaultCadenceDays": 90,
    "incidentRotationHours": 4,
    "requiresDualControlForProduction": true,
    "requiresMaskedCiLogProof": true,
    "requiresProviderAuditLogReference": true
  },
  "secrets": [
    {
      "name": "DATABASE_URL",
      "group": "database",
      "requiredForProduction": true,
      "destinations": ["GitHub Actions preview/staging/production", "Vercel web/dashboard server environment"],
      "rotationCadenceDays": 90,
      "status": "not_configured",
      "requiredEvidence": ["secret-store reference", "masked env check log", "rotation owner"]
    },
    {
      "name": "DIRECT_URL",
      "group": "database",
      "requiredForProduction": true,
      "destinations": ["GitHub Actions migration environment only"],
      "rotationCadenceDays": 90,
      "status": "not_configured",
      "requiredEvidence": ["secret-store reference", "migration-only scope proof", "masked env check log"]
    },
    {
      "name": "AUTH_SECRET",
      "group": "auth",
      "requiredForProduction": true,
      "destinations": ["Vercel dashboard server environment", "Vercel web server environment if session callbacks are enabled"],
      "rotationCadenceDays": 90,
      "status": "not_configured",
      "requiredEvidence": ["secret-store reference", "session rotation plan", "masked env check log"]
    },
    {
      "name": "STRIPE_SECRET_KEY",
      "group": "payments",
      "requiredForProduction": true,
      "destinations": ["Vercel web server environment", "GitHub Actions provider sandbox environment"],
      "rotationCadenceDays": 90,
      "status": "not_configured",
      "requiredEvidence": ["Stripe restricted key scope proof", "secret-store reference", "masked webhook replay log"]
    },
    {
      "name": "STRIPE_WEBHOOK_SECRET",
      "group": "payments",
      "requiredForProduction": true,
      "destinations": ["Vercel web server environment"],
      "rotationCadenceDays": 90,
      "status": "not_configured",
      "requiredEvidence": ["webhook endpoint label", "secret-store reference", "signed replay proof"]
    },
    {
      "name": "SENTRY_AUTH_TOKEN",
      "group": "observability",
      "requiredForProduction": true,
      "destinations": ["GitHub Actions preview/staging/production"],
      "rotationCadenceDays": 90,
      "status": "not_configured",
      "requiredEvidence": ["source-map upload scope proof", "secret-store reference", "masked CI artifact"]
    },
    {
      "name": "VERCEL_TOKEN",
      "group": "deployment",
      "requiredForProduction": true,
      "destinations": ["GitHub Actions preview/staging/production"],
      "rotationCadenceDays": 90,
      "status": "not_configured",
      "requiredEvidence": ["least-privilege token scope proof", "secret-store reference", "masked deploy log"]
    },
    {
      "name": "VERCEL_ORG_ID",
      "group": "deployment",
      "requiredForProduction": true,
      "destinations": ["GitHub Actions preview/staging/production"],
      "rotationCadenceDays": 180,
      "status": "not_configured",
      "requiredEvidence": ["redacted org label", "secret-store reference", "masked env check log"]
    },
    {
      "name": "VERCEL_WEB_PROJECT_ID",
      "group": "deployment",
      "requiredForProduction": true,
      "destinations": ["GitHub Actions preview/staging/production"],
      "rotationCadenceDays": 180,
      "status": "not_configured",
      "requiredEvidence": ["redacted project label", "secret-store reference", "masked deploy log"]
    },
    {
      "name": "VERCEL_DASHBOARD_PROJECT_ID",
      "group": "deployment",
      "requiredForProduction": true,
      "destinations": ["GitHub Actions preview/staging/production"],
      "rotationCadenceDays": 180,
      "status": "not_configured",
      "requiredEvidence": ["redacted project label", "secret-store reference", "masked deploy log"]
    },
    {
      "name": "CSRF_SECRET",
      "group": "security",
      "requiredForProduction": true,
      "destinations": ["Vercel web/dashboard server environments"],
      "rotationCadenceDays": 90,
      "status": "not_configured",
      "requiredEvidence": ["secret-store reference", "token invalidation plan", "masked env check log"]
    },
    {
      "name": "SECURITY_ENCRYPTION_PRIMARY_KEY",
      "group": "security",
      "requiredForProduction": true,
      "destinations": ["managed KMS/Vault reference preferred", "Vercel server environment only as a temporary fallback"],
      "rotationCadenceDays": 180,
      "status": "not_configured",
      "requiredEvidence": ["key version label", "rotation/re-encryption plan", "secret-store reference"]
    },
    {
      "name": "EAS_PROJECT_ID",
      "group": "mobile",
      "requiredForProduction": true,
      "destinations": ["EAS project settings", "GitHub Actions preview/staging/production"],
      "rotationCadenceDays": 180,
      "status": "not_configured",
      "requiredEvidence": ["redacted EAS project label", "EAS secret reference", "preview build artifact"]
    }
  ]
}
