{
  "name": "inkroute-suite",
  "version": "0.1.0",
  "private": true,
  "description": "InkRoute Suite multi-tenant tattoo artist SaaS monorepo scaffold.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @inkroute/db db:generate",
    "db:migrate": "pnpm --filter @inkroute/db db:migrate",
    "db:studio": "pnpm --filter @inkroute/db db:studio",
    "db:seed": "pnpm --filter @inkroute/db db:seed",
    "db:verify-seed": "node scripts/db/verify-seed-readiness.mjs",
    "db:seed-runtime-evidence": "node scripts/db/write-seed-runtime-evidence.mjs",
    "ui:adoption-evidence": "node scripts/ui/write-ui-package-adoption-evidence.mjs",
    "seo:analytics-attribution-evidence": "node scripts/seo/write-seo-analytics-attribution-evidence.mjs",
    "seo:search-console-evidence": "node scripts/seo/write-search-console-evidence.mjs",
    "observability:opentelemetry-evidence": "node scripts/observability/write-opentelemetry-evidence.mjs",
    "observability:github-issue-evidence": "node scripts/observability/write-github-issue-automation-evidence.mjs",
    "release:launch-control-evidence": "node scripts/releases/write-release-launch-control-evidence.mjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:performance:budgets": "node testing/scripts/verify-performance-budgets.mjs",
    "test:manifest": "node testing/scripts/verify-test-manifest.mjs",
    "test:phase14:static": "node testing/scripts/phase14-static-check.mjs",
    "qa:checklists": "node testing/scripts/print-qa-checklists.mjs",
    "legal:verify-review": "node scripts/legal/verify-legal-review.mjs",
    "deploy:check-env": "node deployment/scripts/check-env.mjs",
    "deploy:check-env:strict": "node deployment/scripts/check-env.mjs --env .env.local --target production --strict-values",
    "deploy:verify-provider-envs": "node deployment/scripts/verify-provider-envs.mjs",
    "deploy:verify-secrets": "node deployment/scripts/verify-secret-management.mjs",
    "deploy:verify-mobile": "node deployment/scripts/verify-mobile-deployment.mjs",
    "deploy:verify-database-ops": "node deployment/scripts/verify-database-operations.mjs",
    "deploy:verify-launch-evidence": "node deployment/scripts/verify-launch-evidence.mjs",
    "deploy:verify-ops": "node deployment/scripts/verify-launch-operations.mjs",
    "deploy:checklist": "node deployment/scripts/print-launch-checklist.mjs",
    "deploy:gaps": "node deployment/scripts/final-gap-summary.mjs",
    "handoff:verify-docs": "node scripts/handoff/verify-phase-docs.mjs",
    "handoff:audit": "node scripts/handoff/audit-gap-tracker.mjs",
    "handoff:next": "node scripts/handoff/print-next-agent-tasks.mjs",
    "handoff:verify-ledger": "node scripts/handoff/verify-agent-execution-ledger.mjs",
    "handoff:verify-tooling": "node scripts/handoff/verify-handoff-tooling.mjs",
    "handoff:verify-task-sync": "node scripts/handoff/verify-agent-task-sync.mjs",
    "handoff:all": "pnpm handoff:verify-docs && pnpm handoff:audit && pnpm handoff:next && pnpm handoff:verify-ledger && pnpm handoff:verify-tooling && pnpm handoff:verify-task-sync && pnpm workspace:all && pnpm quality:all",
    "quality:docs": "pnpm quality:doc-links && pnpm quality:doc-consistency && pnpm quality:doc-inventory",
    "quality:gaps": "node scripts/quality/audit-gap-evidence.mjs",
    "quality:pr-gaps": "node scripts/quality/audit-gap-tracker-diff.mjs",
    "quality:pr-gap-fixtures": "node scripts/quality/verify-pr-gap-diff-fixtures.mjs",
    "quality:governance": "node scripts/quality/verify-repository-governance.mjs",
    "quality:required-checks": "node scripts/quality/verify-required-checks.mjs",
    "quality:gates": "node scripts/quality/print-quality-gates.mjs",
    "quality:all": "pnpm quality:docs && pnpm quality:gaps && pnpm quality:pr-gap-fixtures && pnpm quality:governance && pnpm quality:required-checks && pnpm quality:gates",
    "workspace:imports": "node scripts/workspace/audit-workspace-imports.mjs",
    "workspace:scripts": "node scripts/workspace/audit-package-scripts.mjs",
    "workspace:readiness": "node scripts/workspace/print-runtime-readiness.mjs",
    "workspace:runtime-evidence": "node scripts/workspace/verify-runtime-evidence.mjs",
    "workspace:required-checks": "node scripts/workspace/verify-workspace-required-checks.mjs",
    "workspace:toolchain": "node scripts/workspace/verify-workspace-toolchain.mjs",
    "workspace:all": "pnpm workspace:imports && pnpm workspace:scripts && pnpm workspace:runtime-evidence && pnpm workspace:readiness && pnpm workspace:required-checks && pnpm workspace:toolchain",
    "quality:doc-links": "node scripts/quality/audit-doc-links.mjs",
    "quality:doc-consistency": "node scripts/quality/verify-documentation-consistency.mjs",
    "quality:doc-inventory": "node scripts/quality/verify-documentation-inventory.mjs",
    "workspace:verify": "pnpm workspace:imports && pnpm workspace:scripts && pnpm workspace:runtime-evidence",
    "workspace:doctor": "pnpm workspace:readiness && pnpm workspace:required-checks && pnpm workspace:toolchain",
    "workflow:route": "node scripts/workflow/route-serena-obsidian.mjs",
    "workflow:admit": "node scripts/workflow/route-serena-obsidian.mjs --brief",
    "workflow:intake": "node scripts/workflow/route-serena-obsidian.mjs --packet --strict",
    "workflow:route:brief": "node scripts/workflow/route-serena-obsidian.mjs --brief",
    "workflow:route:hot": "node scripts/workflow/route-serena-obsidian.mjs --hot",
    "workflow:hotstart": "node scripts/workflow/route-serena-obsidian.mjs --hot",
    "workflow:codex": "node scripts/workflow/route-serena-obsidian.mjs --hot",
    "workflow:route:micro": "node scripts/workflow/route-serena-obsidian.mjs --micro",
    "workflow:micro": "node scripts/workflow/route-serena-obsidian.mjs --micro",
    "workflow:stoplight": "node scripts/workflow/route-serena-obsidian.mjs --micro",
    "workflow:route:packet": "node scripts/workflow/route-serena-obsidian.mjs --packet",
    "workflow:route:strict": "node scripts/workflow/route-serena-obsidian.mjs --packet --strict",
    "workflow:route:json": "node scripts/workflow/route-serena-obsidian.mjs --json",
    "workflow:obsidian": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-obsidian-vault.ps1",
    "workflow:obsidian:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-obsidian-vault.ps1 -OpenNow",
    "workflow:obsidian:daily": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-obsidian-vault.ps1 -WithDailyNote",
    "workflow:obsidian:daily:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-obsidian-vault.ps1 -WithDailyNote -OpenNow",
    "workflow:obsidian:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-obsidian-vault.ps1 -ForceNotes",
    "workflow:obsidian:force-config": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-obsidian-vault.ps1 -ForceConfig",
    "workflow:obsidian:refresh-all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-obsidian-vault.ps1 -ForceNotes -ForceConfig",
    "workflow:commit-template": "git config commit.template .gitmessage"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "@playwright/test": "^1.49.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0"
  }
}
