generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantPlan {
  solo
  nomad
  studio
  growth
  enterprise
}

enum TenantStatus {
  trial
  active
  past_due
  suspended
  archived
}

enum TenantDomainStatus {
  pending
  verified
  failed
  disabled
}

enum UserStatus {
  invited
  active
  disabled
  archived
}

enum Role {
  owner
  artist
  assistant
  studio_manager
  admin
}

enum MemberStatus {
  invited
  active
  suspended
  removed
}

enum BookingStatus {
  draft
  submitted
  needs_info
  accepted
  declined
  deposit_pending
  deposit_paid
  scheduled
  reschedule_requested
  cancelled
  completed
  no_show
  archived
}

enum BookingEventType {
  submitted
  note_added
  assigned
  needs_info
  accepted
  declined
  deposit_requested
  deposit_paid
  scheduled
  reschedule_requested
  rescheduled
  cancelled
  completed
  no_show
}

enum AppointmentStatus {
  tentative
  confirmed
  reschedule_requested
  rescheduled
  cancelled
  completed
  no_show
}

enum PaymentStatus {
  not_required
  pending
  paid
  failed
  refunded
  partially_refunded
  disputed
}

enum RefundStatus {
  pending
  succeeded
  failed
  cancelled
}

enum PaymentProvider {
  stripe
  manual
  other
}

enum TravelBookingStatus {
  open
  waitlist
  closed
}

enum AvailabilityKind {
  booking
  consultation
  flash
  admin_hold
  blackout
}

enum AvailabilityStatus {
  open
  waitlist
  full
  hidden
}

enum CalendarProvider {
  google
  caldav
  ics
  manual
}

enum CalendarSyncStatus {
  connected
  needs_reauth
  disabled
  error
}

enum FreshnessLabel {
  fresh
  healed
  in_progress
}

enum BodyPlacement {
  arm
  forearm
  upper_arm
  leg
  calf
  thigh
  back
  chest
  ribs
  neck
  hand
  foot
  shoulder
  sternum
  stomach
  head
  other
}

enum FileAssetKind {
  portfolio_original
  portfolio_derivative
  reference_image
  consent_signature
  healed_follow_up
  document
  other
}

enum FileVisibility {
  public
  tenant_private
  client_private
  system_private
}

enum IntakeQuestionType {
  short_text
  long_text
  single_select
  multi_select
  number
  date
  file_upload
  acknowledgement
}

enum FormStatus {
  draft
  published
  archived
}

enum ConsentSignatureStatus {
  pending
  signed
  revoked
  expired
}

enum MedicalAcknowledgmentStatus {
  not_required
  pending
  completed
  flagged_for_review
}

enum MessageChannel {
  in_app
  email
  sms
  system
}

enum MessageDirection {
  inbound
  outbound
  internal
  system
}

enum MessageStatus {
  draft
  queued
  sent
  delivered
  failed
  read
}

enum NotificationChannel {
  in_app
  email
  sms
  push
}

enum NotificationStatus {
  pending
  queued
  sent
  delivered
  failed
  cancelled
}

enum ReviewStatus {
  submitted
  approved
  rejected
  hidden
}

enum SeoPageStatus {
  draft
  published
  noindex
  archived
}

enum ErrorSeverity {
  low
  medium
  high
  critical
}

enum ErrorReportStatus {
  open
  triaged
  in_progress
  resolved
  ignored
}

enum ReleaseChannel {
  development
  preview
  production
  mobile_preview
  mobile_production
}

enum FeatureFlagScope {
  global
  tenant
  user
}

model Tenant {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  plan             TenantPlan             @default(solo)
  status           TenantStatus           @default(trial)
  publicSiteName   String?
  primaryLocale    String                 @default("en-US")
  defaultTimezone  String                 @default("America/Los_Angeles")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  domains          TenantDomain[]
  members          TenantMember[]
  customRoles      CustomRole[]
  studios          Studio[]
  artists          Artist[]
  clients          Client[]
  clientProfiles   ClientProfile[]
  tattooStyles     TattooStyle[]
  portfolioItems   PortfolioItem[]
  portfolioImages  PortfolioImage[]
  travelCities     TravelCity[]
  travelSchedules  TravelSchedule[]
  availability     AvailabilityWindow[]
  calendarAccounts CalendarConnection[]
  calendarEvents   CalendarEvent[]
  bookingRequests  BookingRequest[]
  bookingEvents    BookingStateEvent[]
  appointments     Appointment[]
  deposits         Deposit[]
  payments         Payment[]
  refunds          Refund[]
  paymentAuditLogs PaymentAuditLog[]
  intakeForms      IntakeForm[]
  intakeQuestions  IntakeQuestion[]
  intakeResponses  IntakeResponse[]
  consentForms     ConsentForm[]
  consentSignatures ConsentSignature[]
  medicalSafetyAcknowledgments MedicalSafetyAcknowledgment[]
  fileAssets       FileAsset[]
  referenceImages  ReferenceImage[]
  messageThreads   MessageThread[]
  messages         Message[]
  notifications    Notification[]
  notificationDeliveries NotificationDelivery[]
  reviews          Review[]
  seoCityPages     SeoCityPage[]
  seoStylePages    SeoStylePage[]
  seoRedirects     SeoRedirect[]
  auditLogs        AuditLog[]
  signedUrlGrants  SignedUrlGrant[]
  privacyRequests  PrivacyRequest[]
  retentionTombstones RetentionTombstone[]
  legalDocumentVersions LegalDocumentVersion[]
  legalAcceptanceAudits LegalAcceptanceAudit[]
  abuseEvents     AbuseEvent[]
  securityMiddlewareEvidence SecurityMiddlewareEvidence[]
  securityCoverageRuns SecurityCoverageRun[]
  securityAppRuntimeRuns SecurityAppRuntimeRun[]
  phase14RunnerRuns Phase14RunnerRun[]
  appE2eRuntimeRuns AppE2eRuntimeRun[]
  dbIntegrationRuns DbIntegrationRun[]
  mobileTestingRuns MobileTestingRun[]
  accessibilityVisualRuns AccessibilityVisualRun[]
  providerContractRuns ProviderContractRun[]
  ciCoverageRuns CiCoverageRun[]
  performanceLoadRuns PerformanceLoadRun[]
  deploymentToolingRuns DeploymentToolingRun[]
  providerEnvironmentRuns ProviderEnvironmentRun[]
  secretManagementRuns SecretManagementRun[]
  mobileDeploymentRuns MobileDeploymentRun[]
  databaseOperationsRuns DatabaseOperationsRun[]
  productionLaunchEvidenceRuns ProductionLaunchEvidenceRun[]
  launchOperationsRuns LaunchOperationsRun[]
  agentExecutionLedgerRuns AgentExecutionLedgerRun[]
  handoffToolingRuns HandoffToolingRun[]
  agentTaskTrackingRuns AgentTaskTrackingRun[]
  prGapEvidenceEnforcementRuns PrGapEvidenceEnforcementRun[]
  documentationAuditRuns DocumentationAuditRun[]
  repositoryGovernanceRuns RepositoryGovernanceRun[]
  qualityGateRuns QualityGateRun[]
  prDiffEvidenceRuns PrDiffEvidenceRun[]
  semanticDocumentationRuns SemanticDocumentationRun[]
  requiredChecksRuns RequiredChecksRun[]
  workspaceRuntimeToolchainRuns WorkspaceRuntimeToolchainRun[]
  staticDependencyAuditRuns StaticDependencyAuditRun[]
  runtimeEvidenceRuns RuntimeEvidenceRun[]
  workspaceRequiredChecksRuns WorkspaceRequiredChecksRun[]
  dependencyInstallRuns DependencyInstallRun[]
  prismaLifecycleRuns PrismaLifecycleRun[]
  providerSessionRuns ProviderSessionRun[]
  liveStripePaymentsRuns LiveStripePaymentsRun[]
  providerStorageUploadRuns ProviderStorageUploadRun[]
  publicWebLaunchRuns PublicWebLaunchRun[]
  dashboardLaunchRuns DashboardLaunchRun[]
  mobileLaunchRuns MobileLaunchRun[]
  calendarLaunchRuns CalendarLaunchRun[]
  notificationLaunchRuns NotificationLaunchRun[]
  observabilityLaunchRuns ObservabilityLaunchRun[]
  testingLaunchExecutionRuns TestingLaunchExecutionRun[]
  legalReviewRuns LegalReviewRun[]
  deploymentLaunchEvidenceRuns DeploymentLaunchEvidenceRun[]
  releaseLaunchControlRuns ReleaseLaunchControlRun[]
  uiPackageAdoptionRuns UiPackageAdoptionRun[]
  seedRuntimeExecutionRuns SeedRuntimeExecutionRun[]
  prismaValidationRuns PrismaValidationRun[]
  errors           ErrorReport[]
  releases         ReleaseRecord[]
  flags            FeatureFlag[]

  @@index([status])
  @@index([plan])
}

model TenantDomain {
  id            String             @id @default(cuid())
  tenantId      String
  hostname      String             @unique
  status        TenantDomainStatus @default(pending)
  isPrimary     Boolean            @default(false)
  verifiedAt    DateTime?
  verificationTokenHash String?
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([tenantId, isPrimary])
  @@index([tenantId, status])
}

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  name                  String?
  imageUrl              String?
  status                UserStatus        @default(active)
  lastLoginAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  memberships           TenantMember[]
  artistProfiles        Artist[]
  assignedBookingRequests BookingRequest[]
  bookingStateEvents    BookingStateEvent[]
  paymentAuditLogs      PaymentAuditLog[]
  uploadedFiles         FileAsset[]
  sentMessages          Message[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  releases              ReleaseRecord[]
  privacyRequests       PrivacyRequest[]
  legalAcceptanceAudits LegalAcceptanceAudit[]
  abuseEvents           AbuseEvent[]
}

model TenantMember {
  id           String       @id @default(cuid())
  tenantId     String
  userId       String
  role         Role
  customRoleId String?
  status       MemberStatus @default(active)
  invitedEmail String?
  invitedAt    DateTime?
  joinedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([tenantId, status])
}

model CustomRole {
  id          String         @id @default(cuid())
  tenantId    String
  key         String
  label       String
  permissions String[]
  description String?
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     TenantMember[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Studio {
  id           String            @id @default(cuid())
  tenantId     String
  name         String
  slug         String
  city         String?
  region       String?
  country      String?
  timezone     String?
  addressLine1 String?
  addressLine2 String?
  websiteUrl   String?
  publicNotes  String?
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artists      Artist[]
  travelSchedules TravelSchedule[]
  appointments Appointment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, city])
}

model Artist {
  id             String              @id @default(cuid())
  tenantId       String
  studioId       String?
  userId         String?
  displayName    String
  slug           String
  bio            String
  shortBio       String?
  homeBaseCity   String?
  specialties    String[]
  instagramUrl   String?
  bookingEnabled Boolean             @default(true)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studio         Studio?             @relation(fields: [studioId], references: [id], onDelete: SetNull)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  portfolio      PortfolioItem[]
  travelSchedules TravelSchedule[]
  availability   AvailabilityWindow[]
  calendarConnections CalendarConnection[]
  bookingRequests BookingRequest[]
  appointments   Appointment[]
  reviews        Review[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, studioId])
}

model Client {
  id             String              @id @default(cuid())
  tenantId       String
  email          String
  phone          String?
  preferredName  String
  legalName      String?
  pronouns       String?
  city           String?
  region         String?
  country        String?
  timezone       String?
  marketingOptIn Boolean             @default(false)
  smsOptIn       Boolean             @default(false)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile        ClientProfile?
  bookingRequests BookingRequest[]
  appointments   Appointment[]
  intakeResponses IntakeResponse[]
  consentSignatures ConsentSignature[]
  medicalSafetyAcknowledgments MedicalSafetyAcknowledgment[]
  referenceImages ReferenceImage[]
  fileAssets      FileAsset[]
  messageThreads MessageThread[]
  sentMessages   Message[]
  notifications  Notification[]
  reviews        Review[]
  privacyRequests PrivacyRequest[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, preferredName])
  @@index([tenantId, city])
}

model ClientProfile {
  id                     String   @id @default(cuid())
  tenantId               String
  clientId               String   @unique
  birthdateEncrypted     String?
  emergencyContactEncrypted String?
  medicalNotesEncrypted  String?
  allergiesEncrypted     String?
  skinConcernsEncrypted  String?
  preferredContactMethod String?
  internalNotes          String?
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([tenantId])
}

model TattooStyle {
  id             String          @id @default(cuid())
  tenantId       String
  slug           String
  label          String
  description    String?
  isActive       Boolean         @default(true)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portfolioItems PortfolioItem[]
  seoStylePages  SeoStylePage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
}

model PortfolioItem {
  id              String          @id @default(cuid())
  tenantId        String
  artistId        String
  title           String
  slug            String
  caption         String
  placement       BodyPlacement
  freshness       FreshnessLabel
  bodySide        String?
  city            String?
  completedAt     DateTime?
  sessionCount    Int?
  isFeatured      Boolean         @default(false)
  isPublic        Boolean         @default(false)
  publishedAt     DateTime?
  attributionKey  String          @unique
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artist          Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  styles          TattooStyle[]
  images          PortfolioImage[]
  attributedBookingRequests BookingRequest[] @relation("PortfolioAttribution")
  seoCityPages    SeoCityPage[]
  seoStylePages   SeoStylePage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, artistId])
  @@index([tenantId, isFeatured])
  @@index([tenantId, isPublic, publishedAt])
}

model PortfolioImage {
  id              String          @id @default(cuid())
  tenantId        String
  portfolioItemId String
  fileAssetId     String?
  imageUrl        String
  altText         String
  width           Int?
  height          Int?
  sortOrder       Int             @default(0)
  isPrimary       Boolean         @default(false)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portfolioItem   PortfolioItem   @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  fileAsset       FileAsset?      @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId, portfolioItemId])
  @@index([tenantId, isPrimary])
}

model TravelCity {
  id              String            @id @default(cuid())
  tenantId        String
  slug            String
  city            String
  region          String
  country         String
  timezone        String
  latitude        Decimal?
  longitude       Decimal?
  publicSummary   String?
  waitlistEnabled Boolean           @default(true)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  travelSchedules TravelSchedule[]
  availability    AvailabilityWindow[]
  bookingRequests BookingRequest[]
  appointments    Appointment[]
  seoCityPages    SeoCityPage[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, city])
  @@index([tenantId, waitlistEnabled])
}

model TravelSchedule {
  id              String              @id @default(cuid())
  tenantId        String
  artistId        String
  travelCityId    String
  studioId        String?
  title           String
  startsAt        DateTime
  endsAt          DateTime
  timezone        String
  bookingStatus   TravelBookingStatus @default(open)
  guestSpotUrl    String?
  publicNotes     String?
  internalNotes   String?
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artist          Artist              @relation(fields: [artistId], references: [id], onDelete: Cascade)
  travelCity      TravelCity          @relation(fields: [travelCityId], references: [id], onDelete: Cascade)
  studio          Studio?             @relation(fields: [studioId], references: [id], onDelete: SetNull)
  availability    AvailabilityWindow[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenantId, artistId, startsAt])
  @@index([tenantId, travelCityId, startsAt])
  @@index([tenantId, bookingStatus])
}

model AvailabilityWindow {
  id               String             @id @default(cuid())
  tenantId         String
  artistId         String
  travelCityId     String?
  travelScheduleId String?
  kind             AvailabilityKind   @default(booking)
  status           AvailabilityStatus @default(open)
  startsAt         DateTime
  endsAt           DateTime
  timezone         String
  maxBookings      Int?
  bufferBeforeMinutes Int             @default(0)
  bufferAfterMinutes  Int             @default(0)
  publicLabel      String?
  internalNotes    String?
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artist           Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  travelCity       TravelCity?        @relation(fields: [travelCityId], references: [id], onDelete: SetNull)
  travelSchedule   TravelSchedule?    @relation(fields: [travelScheduleId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId, artistId, startsAt])
  @@index([tenantId, travelCityId, startsAt])
  @@index([tenantId, status])
}

model CalendarConnection {
  id                 String             @id @default(cuid())
  tenantId           String
  artistId           String?
  provider           CalendarProvider
  providerAccountId  String?
  displayName        String
  encryptedAccessToken String?
  encryptedRefreshToken String?
  syncStatus         CalendarSyncStatus @default(connected)
  lastSyncedAt       DateTime?
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artist             Artist?            @relation(fields: [artistId], references: [id], onDelete: SetNull)
  events             CalendarEvent[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId, provider])
  @@index([tenantId, artistId])
}

model CalendarEvent {
  id                   String              @id @default(cuid())
  tenantId             String
  calendarConnectionId String?
  appointmentId        String?
  provider             CalendarProvider    @default(manual)
  externalEventId      String?
  title                String
  startsAt             DateTime
  endsAt               DateTime
  timezone             String
  status               String              @default("confirmed")
  rawPayload           Json?
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendarConnection   CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: SetNull)
  appointment          Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([tenantId, startsAt])
  @@index([tenantId, externalEventId])
  @@index([tenantId, appointmentId])
}

model BookingRequest {
  id                     String        @id @default(cuid())
  tenantId               String
  artistId               String
  clientId               String
  travelCityId           String?
  assignedToUserId       String?
  status                 BookingStatus @default(submitted)
  clientNameSnapshot     String
  clientEmailSnapshot    String
  clientPhoneSnapshot    String?
  preferredCity          String
  preferredDate          DateTime?
  style                  String
  placement              BodyPlacement
  sizeEstimate           String
  budgetMinCents         Int?
  budgetMaxCents         Int?
  ideaSummary            String
  medicalNotesEncrypted  String?
  readinessScore         Int           @default(0)
  policyAcceptedAt       DateTime?
  portfolioAttributionId String?
  source                 String        @default("public_site")
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artist                 Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  client                 Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  travelCity             TravelCity?   @relation(fields: [travelCityId], references: [id], onDelete: SetNull)
  assignedToUser         User?         @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  portfolioAttribution   PortfolioItem? @relation("PortfolioAttribution", fields: [portfolioAttributionId], references: [id], onDelete: SetNull)
  stateEvents            BookingStateEvent[]
  appointment            Appointment?
  deposits               Deposit[]
  payments               Payment[]
  refunds                Refund[]
  intakeResponses        IntakeResponse[]
  consentSignatures      ConsentSignature[]
  medicalSafetyAcknowledgments MedicalSafetyAcknowledgment[]
  referenceImages        ReferenceImage[]
  messageThreads         MessageThread[]
  notifications          Notification[]
  reviews                Review[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([tenantId, preferredCity])
  @@index([tenantId, travelCityId])
  @@index([artistId, createdAt])
  @@index([clientId, createdAt])
}

model BookingStateEvent {
  id               String           @id @default(cuid())
  tenantId         String
  bookingRequestId String
  actorUserId      String?
  type             BookingEventType
  fromStatus       BookingStatus?
  toStatus         BookingStatus?
  note             String?
  metadata         Json?
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingRequest   BookingRequest   @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  actorUser        User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())

  @@index([tenantId, bookingRequestId, createdAt])
  @@index([tenantId, type])
}

model Appointment {
  id                String            @id @default(cuid())
  tenantId          String
  artistId          String
  clientId          String
  bookingRequestId  String?           @unique
  travelCityId      String?
  studioId          String?
  status            AppointmentStatus @default(tentative)
  title             String
  startsAt          DateTime
  endsAt            DateTime
  timezone          String
  locationLabel     String?
  depositRequiredCents Int?
  internalNotes     String?
  clientPrepNotes   String?
  noShowMarkedAt    DateTime?
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artist            Artist            @relation(fields: [artistId], references: [id], onDelete: Cascade)
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bookingRequest    BookingRequest?   @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  travelCity        TravelCity?       @relation(fields: [travelCityId], references: [id], onDelete: SetNull)
  studio            Studio?           @relation(fields: [studioId], references: [id], onDelete: SetNull)
  calendarEvents    CalendarEvent[]
  deposits          Deposit[]
  payments          Payment[]
  messageThreads    MessageThread[]
  notifications     Notification[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([tenantId, artistId, startsAt])
  @@index([tenantId, clientId, startsAt])
  @@index([tenantId, status, startsAt])
}

model Deposit {
  id                 String          @id @default(cuid())
  tenantId           String
  bookingRequestId   String
  appointmentId      String?
