  @@index([commitSha])
}

model ErrorReport {
  id             String            @id @default(cuid())
  tenantId       String?
  severity       ErrorSeverity
  status         ErrorReportStatus @default(open)
  source         String
  message        String
  stackHash      String?
  release        String?
  route          String?
  userAgent      String?
  metadata       Json?
  tenant         Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?

  @@index([tenantId, severity, createdAt])
  @@index([tenantId, status])
  @@index([stackHash])
}

model ReleaseRecord {
  id              String         @id @default(cuid())
  tenantId        String?
  releasedByUserId String?
  version         String
  channel         ReleaseChannel
  commitSha       String?
  ciWorkflowRunId  String?
  ciWorkflowRunUrl String?
  ciStatus        String?
  ciCompletedAt   DateTime?
  notes           String
  migrationVersion String?
  mobileRuntimeVersion String?
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  releasedByUser  User?          @relation(fields: [releasedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([tenantId, channel, createdAt])
  @@index([version, channel])
  @@index([ciWorkflowRunId])
}

model FeatureFlag {
  id          String           @id @default(cuid())
  tenantId    String?
  key         String
  scope       FeatureFlagScope @default(tenant)
  enabled     Boolean          @default(false)
  description String
  rules       Json?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, key])
  @@index([key])
  @@index([tenantId, enabled])
}
