  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, city])
}

model SeoStylePage {
  id              String         @id @default(cuid())
  tenantId        String
  tattooStyleId   String?
  slug            String
  styleName       String
  title           String
  metaDescription String
  canonicalPath   String
  status          SeoPageStatus  @default(draft)
  bodyCopy        String?
  faq             Json?
  internalLinks   Json?
  featuredPortfolio PortfolioItem[]
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tattooStyle     TattooStyle?   @relation(fields: [tattooStyleId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, tattooStyleId])
}

model SeoRedirect {
  id          String   @id @default(cuid())
  tenantId    String
  fromPath    String
  toPath      String
  statusCode  Int      @default(301)
  isActive    Boolean  @default(true)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, fromPath])
  @@index([tenantId, isActive])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

model ErrorReport {
  id             String            @id @default(cuid())
  tenantId       String?
  severity       ErrorSeverity
  status         ErrorReportStatus @default(open)
  source         String
  message        String
  stackHash      String?
  release        String?
  route          String?
  userAgent      String?
  metadata       Json?
  tenant         Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?

  @@index([tenantId, severity, createdAt])
  @@index([tenantId, status])
  @@index([stackHash])
}

model ReleaseRecord {
  id              String         @id @default(cuid())
  tenantId        String?
  releasedByUserId String?
  version         String
  channel         ReleaseChannel
  commitSha       String?
  notes           String
  migrationVersion String?
  mobileRuntimeVersion String?
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  releasedByUser  User?          @relation(fields: [releasedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([tenantId, channel, createdAt])
  @@index([version, channel])
}

model FeatureFlag {
  id          String           @id @default(cuid())
  tenantId    String?
  key         String
  scope       FeatureFlagScope @default(tenant)
  enabled     Boolean          @default(false)
  description String
  rules       Json?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, key])
  @@index([key])
  @@index([tenantId, enabled])
}
