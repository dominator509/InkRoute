<file path="packages/db/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantPlan {
  solo
  nomad
  studio
  growth
  enterprise
}

enum TenantStatus {
  trial
  active
  past_due
  suspended
  archived
}

enum TenantDomainStatus {
  pending
  verified
  failed
  disabled
}

enum UserStatus {
  invited
  active
  disabled
  archived
}

enum Role {
  owner
  artist
  assistant
  studio_manager
  admin
}

enum MemberStatus {
  invited
  active
  suspended
  removed
}

enum BookingStatus {
  draft
  submitted
  needs_info
  accepted
  declined
  deposit_pending
  deposit_paid
  scheduled
  reschedule_requested
  cancelled
  completed
  no_show
  archived
}

enum BookingEventType {
  submitted
  note_added
  assigned
  needs_info
  accepted
  declined
  deposit_requested
  deposit_paid
  scheduled
  reschedule_requested
  rescheduled
  cancelled
  completed
  no_show
}

enum AppointmentStatus {
  tentative
  confirmed
  reschedule_requested
  rescheduled
  cancelled
  completed
  no_show
}

enum PaymentStatus {
  not_required
  pending
  paid
  failed
  refunded
  partially_refunded
  disputed
}

enum RefundStatus {
  pending
  succeeded
  failed
  cancelled
}

enum PaymentProvider {
  stripe
  manual
  other
}

enum TravelBookingStatus {
  open
  waitlist
  closed
}

enum AvailabilityKind {
  booking
  consultation
  flash
  admin_hold
  blackout
}

enum AvailabilityStatus {
  open
  waitlist
  full
  hidden
}

enum CalendarProvider {
  google
  caldav
  ics
  manual
}

enum CalendarSyncStatus {
  connected
  needs_reauth
  disabled
  error
}

enum FreshnessLabel {
  fresh
  healed
  in_progress
}

enum BodyPlacement {
  arm
  forearm
  upper_arm
  leg
  calf
  thigh
  back
  chest
  ribs
  neck
  hand
  foot
  shoulder
  sternum
  stomach
  head
  other
}

enum FileAssetKind {
  portfolio_original
  portfolio_derivative
  reference_image
  consent_signature
  healed_follow_up
  document
  other
}

enum FileVisibility {
  public
  tenant_private
  client_private
  system_private
}

enum IntakeQuestionType {
  short_text
  long_text
  single_select
  multi_select
  number
  date
  file_upload
  acknowledgement
}

enum FormStatus {
  draft
  published
  archived
}

enum ConsentSignatureStatus {
  pending
  signed
  revoked
  expired
}

enum MedicalAcknowledgmentStatus {
  not_required
  pending
  completed
  flagged_for_review
}

enum MessageChannel {
  in_app
  email
  sms
  system
}

enum MessageDirection {
  inbound
  outbound
  internal
  system
}

enum MessageStatus {
  draft
  queued
  sent
  delivered
  failed
  read
}

enum NotificationChannel {
  in_app
  email
  sms
  push
}

enum NotificationStatus {
  pending
  queued
  sent
  delivered
  failed
  cancelled
}

enum ReviewStatus {
  submitted
  approved
  rejected
  hidden
}

enum SeoPageStatus {
  draft
  published
  noindex
  archived
}

enum ErrorSeverity {
  low
  medium
  high
  critical
}

enum ErrorReportStatus {
  open
  triaged
  in_progress
  resolved
  ignored
}

enum ReleaseChannel {
  development
  preview
  production
  mobile_preview
  mobile_production
}

enum FeatureFlagScope {
  global
  tenant
  user
}

model Tenant {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  plan             TenantPlan             @default(solo)
  status           TenantStatus           @default(trial)
  publicSiteName   String?
  primaryLocale    String                 @default("en-US")
  defaultTimezone  String                 @default("America/Los_Angeles")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  domains          TenantDomain[]
  members          TenantMember[]
  customRoles      CustomRole[]
  studios          Studio[]
  artists          Artist[]
  clients          Client[]
  clientProfiles   ClientProfile[]
  tattooStyles     TattooStyle[]
  portfolioItems   PortfolioItem[]
  portfolioImages  PortfolioImage[]
  travelCities     TravelCity[]
  travelSchedules  TravelSchedule[]
  availability     AvailabilityWindow[]
  calendarAccounts CalendarConnection[]
  calendarEvents   CalendarEvent[]
  bookingRequests  BookingRequest[]
  bookingEvents    BookingStateEvent[]
  appointments     Appointment[]
  deposits         Deposit[]
  payments         Payment[]
  refunds          Refund[]
  paymentAuditLogs PaymentAuditLog[]
  intakeForms      IntakeForm[]
  intakeQuestions  IntakeQuestion[]
  intakeResponses  IntakeResponse[]
  consentForms     ConsentForm[]
  consentSignatures ConsentSignature[]
  medicalSafetyAcknowledgments MedicalSafetyAcknowledgment[]
  fileAssets       FileAsset[]
  referenceImages  ReferenceImage[]
  messageThreads   MessageThread[]
  messages         Message[]
  notifications    Notification[]
  notificationDeliveries NotificationDelivery[]
  reviews          Review[]
  seoCityPages     SeoCityPage[]
  seoStylePages    SeoStylePage[]
  seoRedirects     SeoRedirect[]
  auditLogs        AuditLog[]
  errors           ErrorReport[]
  releases         ReleaseRecord[]
  flags            FeatureFlag[]

  @@index([status])
  @@index([plan])
}

model TenantDomain {
  id            String             @id @default(cuid())
  tenantId      String
  hostname      String             @unique
  status        TenantDomainStatus @default(pending)
  isPrimary     Boolean            @default(false)
  verifiedAt    DateTime?
  verificationTokenHash String?
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([tenantId, isPrimary])
  @@index([tenantId, status])
}

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  name                  String?
  imageUrl              String?
  status                UserStatus        @default(active)
  lastLoginAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  memberships           TenantMember[]
  artistProfiles        Artist[]
  assignedBookingRequests BookingRequest[]
  bookingStateEvents    BookingStateEvent[]
  paymentAuditLogs      PaymentAuditLog[]
  uploadedFiles         FileAsset[]
  sentMessages          Message[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  releases              ReleaseRecord[]
}

model TenantMember {
  id           String       @id @default(cuid())
  tenantId     String
  userId       String
  role         Role
  customRoleId String?
  status       MemberStatus @default(active)
  invitedEmail String?
  invitedAt    DateTime?
  joinedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([tenantId, status])
}

model CustomRole {
  id          String         @id @default(cuid())
  tenantId    String
  key         String
  label       String
  permissions String[]
  description String?
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     TenantMember[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Studio {
  id           String            @id @default(cuid())
  tenantId     String
  name         String
  slug         String
  city         String?
  region       String?
  country      String?
  timezone     String?
  addressLine1 String?
  addressLine2 String?
  websiteUrl   String?
  publicNotes  String?
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artists      Artist[]
  travelSchedules TravelSchedule[]
  appointments Appointment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, city])
}

model Artist {
  id             String              @id @default(cuid())
  tenantId       String
  studioId       String?
  userId         String?
  displayName    String
  slug           String
  bio            String
  shortBio       String?
  homeBaseCity   String?
  specialties    String[]
  instagramUrl   String?
  bookingEnabled Boolean             @default(true)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studio         Studio?             @relation(fields: [studioId], references: [id], onDelete: SetNull)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  portfolio      PortfolioItem[]
  travelSchedules TravelSchedule[]
  availability   AvailabilityWindow[]
  calendarConnections CalendarConnection[]
  bookingRequests BookingRequest[]
  appointments   Appointment[]
  reviews        Review[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, studioId])
}

model Client {
  id             String              @id @default(cuid())
  tenantId       String
  email          String
  phone          String?
  preferredName  String
  legalName      String?
  pronouns       String?
  city           String?
  region         String?
  country        String?
  timezone       String?
  marketingOptIn Boolean             @default(false)
  smsOptIn       Boolean             @default(false)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile        ClientProfile?
  bookingRequests BookingRequest[]
  appointments   Appointment[]
  intakeResponses IntakeResponse[]
  consentSignatures ConsentSignature[]
  medicalSafetyAcknowledgments MedicalSafetyAcknowledgment[]
  referenceImages ReferenceImage[]
  fileAssets      FileAsset[]
  messageThreads MessageThread[]
  sentMessages   Message[]
  notifications  Notification[]
  reviews        Review[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, preferredName])
  @@index([tenantId, city])
}

model ClientProfile {
  id                     String   @id @default(cuid())
  tenantId               String
  clientId               String   @unique
  birthdateEncrypted     String?
  emergencyContactEncrypted String?
  medicalNotesEncrypted  String?
  allergiesEncrypted     String?
  skinConcernsEncrypted  String?
  preferredContactMethod String?
  internalNotes          String?
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([tenantId])
}

model TattooStyle {
  id             String          @id @default(cuid())
  tenantId       String
  slug           String
  label          String
  description    String?
  isActive       Boolean         @default(true)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portfolioItems PortfolioItem[]
  seoStylePages  SeoStylePage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
}

model PortfolioItem {
  id              String          @id @default(cuid())
  tenantId        String
  artistId        String
